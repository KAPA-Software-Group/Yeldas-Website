# Web3Forms access key for the contact form (https://web3forms.com).
# Required. Vite inlines this at BUILD time, so it must be present when the
# bundle is built - setting it afterwards has no effect until a rebuild.
# Without it the form reports "Something went wrong" and never sends a request.
VITE_WEB3FORMS_ACCESS_KEY=

VITE_GTM_ID=GTM-NWWHCQJ3
VITE_GTM_SCRIPT_PARAM=eeo25xmz=HwpHNCc6VzshOTIwIj1JUwBTSF1CUR4bSw8UBBIFExkXGVQQEg%3D%3D
